{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{database.json,*.html,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?path=/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?path=/$1"
    },
    {
      "source": "/voice_notes/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/navigator",
      "destination": "/jkuat_navigator.html"
    },
    {
      "source": "/jkuat_navigator",
      "destination": "/jkuat_navigator.html"
    },
    {
      "source": "/map",
      "destination": "/jkuatmap.html"
    },
    {
      "source": "/jkuatmap",
      "destination": "/jkuatmap.html"
    },
    {
      "source": "/campus-map",
      "destination": "/jkuatmap.html"
    },
    {
      "source": "/expenses",
      "destination": "/expenses.html"
    },
  ]
}
