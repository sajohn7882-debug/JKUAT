rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150;
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 50
        && data.userId is string && data.userId.size() <= 128;
    }

    function isValidExperience(data) {
      return data.id is string && data.id.size() <= 128
        && data.destination is string && data.destination.size() > 0 && data.destination.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 500;
    }

    function isValidStranded(data) {
      return data.id is string && data.id.size() <= 128
        && data.location is string && data.location.size() > 0 && data.location.size() <= 150
        && data.message is string && data.message.size() <= 500;
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && (data.text is string && data.text.size() <= 1000);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(expenseId) && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow delete: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid;
    }

    // Campus Walking Route Experiences
    match /experiences/{experienceId} {
      allow read: if true;
      allow create: if isValidId(experienceId) && isValidExperience(incoming());
      allow update, delete: if isSignedIn() && isValidId(experienceId) && existing().userId == request.auth.uid;
    }

    // Stranded Student Safety Alerts
    match /stranded/{alertId} {
      allow read: if true;
      allow create: if isValidId(alertId) && isValidStranded(incoming());
      allow update: if isValidId(alertId) && incoming().diff(existing()).affectedKeys().hasOnly(['resolved']);
      allow delete: if isSignedIn() && isValidId(alertId) && existing().userId == request.auth.uid;
    }

    // Campus Chat Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
