{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered campus user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "displayName", "email"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Student budget expenditure record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "amount", "category", "userId"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Route walkability feedback and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destination": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "destination", "rating", "comment"]
    },
    "StrandedAlert": {
      "title": "StrandedAlert",
      "description": "Student stranded notification on campus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "location": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "resolved": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "location", "message"]
    },
    "Message": {
      "title": "Message",
      "description": "Campus community chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "senderId": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 100 },
        "voiceUrl": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Student personal expense records"
    },
    "/experiences/{experienceId}": {
      "schema": { "$ref": "#/entities/Experience" },
      "description": "Student route experiences and feedback"
    },
    "/stranded/{alertId}": {
      "schema": { "$ref": "#/entities/StrandedAlert" },
      "description": "Campus assistance alerts"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Community public chat messages"
    }
  }
}
